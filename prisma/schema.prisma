generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  path      String
  category  String   @default("other")
  status    String   @default("incubating")
  summary   String   @default("")
  tags      String   @default("")
  lastNote  String   @default("") @map("last_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  contestLinks ContestProject[]
}

model Contest {
  id          Int      @id @default(autoincrement())
  name        String
  organizer   String   @default("")
  track       String   @default("")
  startDate   String   @default("") @map("start_date")
  deadline    String   @default("")
  resultDate  String   @default("") @map("result_date")
  status      String   @default("research")
  submitLink  String   @default("") @map("submit_link")
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deliverables Deliverable[]
  links        ContestProject[]
}

model Deliverable {
  id        Int       @id @default(autoincrement())
  contestId Int       @map("contest_id")
  name      String
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  stage     String    @default("")
  path      String    @default("")
  contest   Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
}

model ContestProject {
  id        Int     @id @default(autoincrement())
  contestId Int     @map("contest_id")
  projectId Int     @map("project_id")
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([contestId, projectId])
}

model Connection {
  id            Int       @id @default(autoincrement())
  toolName      String    @map("tool_name")
  category      String    @default("other")
  entryUrl      String    @default("") @map("entry_url")
  accountNotes  String    @default("") @map("account_notes")
  credentialRef String    @default("") @map("credential_ref")
  launchCommand String    @default("") @map("launch_command")
  status        String    @default("active")
  tags          String    @default("")
  notes         String    @default("")
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      ConnectionAccount[]
}

model ConnectionAccount {
  id            Int        @id @default(autoincrement())
  connectionId  Int        @map("connection_id")
  label         String
  launchCommand String     @default("") @map("launch_command")
  notes         String     @default("")
  createdAt     DateTime   @default(now()) @map("created_at")
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model SopTemplate {
  id          Int       @id @default(autoincrement())
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  steps       SopStep[]
}

model SopStep {
  id         Int         @id @default(autoincrement())
  templateId Int         @map("template_id")
  name       String
  sortOrder  Int         @default(0) @map("sort_order")
  template   SopTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model EventLog {
  id         Int      @id @default(autoincrement())
  ts         DateTime @default(now())
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  action     String
  beforeJson String   @default("{}") @map("before_json")
  afterJson  String   @default("{}") @map("after_json")
}

model LaunchScene {
  id        Int             @id @default(autoincrement())
  name      String
  notes     String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  items     LaunchSceneItem[]
}

model LaunchSceneItem {
  id        Int         @id @default(autoincrement())
  sceneId   Int         @map("scene_id")
  kind      String      // connection | account
  refId     Int         @map("ref_id")
  sortOrder Int         @default(0) @map("sort_order")
  scene     LaunchScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  @@unique([sceneId, kind, refId])
}

// M31 日历备注/提醒：与比赛解耦的按天自由条目。date 写入前一律 normDate 归一。
// kind=note 纯备忘；kind=reminder 当日待办（done 可勾选完成）。仅工作台内视觉提醒，不含系统级时间推送。
model CalendarNote {
  id        Int       @id @default(autoincrement())
  date      String    @map("date")
  text      String
  kind      String    @default("note")
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([date])
}
